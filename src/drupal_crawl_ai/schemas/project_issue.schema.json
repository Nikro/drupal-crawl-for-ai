{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://drupal-crawl-for-ai.github.io/schemas/project_issue.schema.json",
  "title": "Project Issue",
  "description": "Canonical record for a Drupal.org project issue.",
  "type": "object",
  "required": ["nid", "title", "status", "priority", "created", "changed", "record_type", "source_url", "fetched_at"],
  "properties": {
    "record_type": {"const": "project_issue"},
    "nid": {"type": "integer"},
    "title": {"type": "string"},
    "body": {"type": "string"},
    "status": {"type": "string"},
    "priority": {"type": "string"},
    "created": {"type": "string", "format": "date-time"},
    "changed": {"type": "string", "format": "date-time"},
    "comment_count": {"type": "integer"},
    "field_project": {"type": "integer"},
    "source_url": {"type": "string", "format": "uri"},
    "source_endpoint": {"type": "string"},
    "source_params": {"type": "object"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "raw_payload": {"type": "object"}
  }
}